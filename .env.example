# Path to local posts performance log file (JSON format)
POSTS_LOG_PATH=examples/sample_posts.json

# Trailing post window size N for calculating baseline rolling average (default: 5)
ROLLING_WINDOW_SIZE=5

# Threshold percentage drop below rolling average to trigger underperforming alert (default: 40.0)
UNDERPERFORM_THRESHOLD_PERCENT=40.0

# Optional: Telegram credentials for push notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
